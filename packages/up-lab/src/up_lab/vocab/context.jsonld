{
  "@context": {
    "uplab": "urn:uplab:ns#",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "@vocab": "urn:uplab:ns#",
    "Activity": "prov:Activity",
    "SoftwareAgent": "prov:SoftwareAgent",
    "Entity": "prov:Entity",
    "wasGeneratedBy": {"@id": "prov:wasGeneratedBy", "@type": "@id"},
    "wasAssociatedWith": {"@id": "prov:wasAssociatedWith", "@type": "@id"},
    "used": {"@id": "prov:used", "@type": "@id"},
    "startedAt": {"@id": "prov:startedAtTime", "@type": "xsd:dateTime"},
    "endedAt": {"@id": "prov:endedAtTime", "@type": "xsd:dateTime"},
    "experiment": {"@type": "@id"},
    "task": {"@type": "@id"},
    "variant": {"@type": "@id"},
    "request": {"@type": "@id"},
    "domain": {"@type": "@id"},
    "source": {"@type": "@id"},
    "planner": {"@type": "@id"},
    "duplicateOf": {"@type": "@id"},
    "wallTime": {"@type": "xsd:double"},
    "cpuTime": {"@type": "xsd:double"},
    "peakMemoryMb": {"@type": "xsd:double"},
    "parseWallTime": {"@type": "xsd:double"},
    "parseCpuTime": {"@type": "xsd:double"},
    "compileWallTime": {"@type": "xsd:double"},
    "compileCpuTime": {"@type": "xsd:double"},
    "solveWallTime": {"@type": "xsd:double"},
    "solveCpuTime": {"@type": "xsd:double"},
    "firstPlanWallTime": {"@type": "xsd:double"},
    "firstPlanCpuTime": {"@type": "xsd:double"},
    "lastPlanWallTime": {"@type": "xsd:double"},
    "lastPlanCpuTime": {"@type": "xsd:double"},
    "foundWallTime": {"@type": "xsd:double"},
    "foundCpuTime": {"@type": "xsd:double"},
    "timeLimit": {"@type": "xsd:double"},
    "memoryLimitMb": {"@type": "xsd:double"},
    "machineMemoryMb": {"@type": "xsd:double"},
    "qualityBound": {"@type": "xsd:double"},
    "referenceCost": {"@type": "xsd:double"},
    "bestCost": {"@type": "xsd:double"},
    "cost": {"@type": "xsd:double"},
    "claimedCost": {"@type": "xsd:double"}
  }
}
