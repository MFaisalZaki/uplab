# Per variant: its coverage, marginal contribution to the virtual best
# solver and Shapley value, next to the VBS coverage (analysis: portfolio).
PREFIX uplab: <urn:uplab:ns#>
SELECT ?request ?variant ?coverage ?marginal ?shapley ?exact ?vbs_coverage ?tasks WHERE {
  ?c a uplab:PortfolioContribution ;
     uplab:forRequest ?q ;
     uplab:forVariant/uplab:name ?variant ;
     uplab:coveredTasks ?coverage ;
     uplab:marginalContribution ?marginal ;
     uplab:shapleyValue ?shapley ;
     uplab:shapleyExact ?exact .
  ?q uplab:name ?request .
  ?vbs a uplab:VirtualBestSolver ;
       uplab:forRequest ?q ;
       uplab:coveredTasks ?vbs_coverage ;
       uplab:tasks ?tasks .
}
ORDER BY ?request DESC(?shapley) ?variant
